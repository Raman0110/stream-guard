# Copy to .env and adjust. Docker Compose reads .env automatically.

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=sensor-readings
KAFKA_DLQ_TOPIC=sensor-readings-dlq

# --- PostgreSQL ---
POSTGRES_USER=streamguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# --- Producer (used from milestone 2) ---
NUM_SENSORS=5
EVENTS_PER_SECOND=10
RANDOM_SEED=42
# Probability that a reading is an injected anomaly (spike or stuck value), 0 = none
ANOMALY_RATE=0
# Degrees C added to the temperature mean per reading (slow drift), 0 = none
DRIFT_PER_READING=0
# Probability of emitting a malformed message (to exercise the dead-letter queue)
INVALID_RATE=0

# --- Model (path to the trained artifact; `make train` creates it) ---
MODEL_PATH=models/model.joblib

# --- Drift monitoring ---
BASELINE_FEATURES_PATH=models/baseline_features.csv
DRIFT_WINDOW_SIZE=1000
DRIFT_CHECK_INTERVAL_SECONDS=30
